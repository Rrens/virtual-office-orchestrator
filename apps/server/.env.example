# Server Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL="postgresql://vouser:vopassword@localhost:5432/virtual_office"
POSTGRES_USER=vouser
POSTGRES_PASSWORD=vopassword
POSTGRES_DB=virtual_office

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Frontend
FRONTEND_URL=http://localhost:3000

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=virtual-office-server
KAFKA_GROUP_ID=virtual-office-consumers

# Model Providers
# Tier 1 - Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_CODE=qwen2.5-coder:7b
OLLAMA_MODEL_GENERAL=llama3.1:8b

# Tier 2 - 9Router
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=https://api.9router.com/v1

# Tier 3 - Cloud fallback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
